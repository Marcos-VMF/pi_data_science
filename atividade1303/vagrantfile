Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/focal64"
  
  # Enable VirtualBox provider
  config.vm.provider "virtualbox" do |vb|
    vb.memory = "1024"
    vb.cpus = 2
  end
  
  # Copy file from the current folder to the VM
  config.vm.provision "file", source: "./script.js", destination: "/home/vagrant/script.js"
  
  # Run a script with Node.js
  config.vm.provision "shell", inline: <<-SHELL
    sudo apt update
    sudo apt install -y nodejs npm
    node script.js
  SHELL
end
